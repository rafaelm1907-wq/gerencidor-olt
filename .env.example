# Copie para /etc/olt-vision.env. Não salve segredos no Git.
DATA_ROOT=/var/lib/olt-vision
OLT_ENV_ROOT=/etc/olt-vision/olts
AUTH_DB=/var/lib/olt-vision/auth.db
VIEWER_USERNAME=viewer
HISTORY_DAYS=2
FAST_POLL_INTERVAL=120
TRAFFIC_POLL_INTERVAL=60
COOKIE_SECURE=0
LICENSE_API_URL=https://lvllicencas.lvltech.com.br/api/v1
LICENSE_PRODUCT="LVL - gerenciador de OLTs"
LICENSE_FILE=/etc/olt-vision/license.env

